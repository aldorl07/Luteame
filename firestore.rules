rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 1. Usuarios
    match /usuarios/{uid} {
      allow read, write: if true;
    }

    // 2. Productos: Catálogo general de hardware
    match /productos/{productId} {
      allow read, write: if true;
    }

    // 3. Setups Guardados: Configuraciones de PC
    match /setups_guardados/{setupId} {
      allow read, write: if true;
    }

    // 4. Equipos Ensamblados y Garantías
    match /equipos_ensamblados/{equipoId} {
      allow read, write: if true;
    }

    // 5. Pedidos: Checkout y compras
    match /pedidos/{pedidoId} {
      allow read, write: if true;
    }

    // 6. Tickets de Soporte
    match /tickets_soporte/{ticketId} {
      allow read, write: if true;
    }

    // 7. Leads / CRM y Seguimiento
    match /leads/{leadId} {
      allow read, write: if true;
    }

    // 8. Cotizaciones Oficiales del Carrito
    match /cotizaciones/{cotizacionId} {
      allow read, write: if true;
    }
  }
}
